@base = http://localhost:4000/api

### ============================================================
### AUTH
### ============================================================

### Registro (201 + Location). El rol lo asigna el servidor.
# @name register
POST {{base}}/auth/register
Content-Type: application/json

{
    "name": "Test",
    "email": "test@example.com",
    "password": "testpass123"
}

### Registro duplicado (409 CONFLICT)
POST {{base}}/auth/register
Content-Type: application/json

{
    "name": "Test",
    "email": "test@example.com",
    "password": "testpass123"
}

### Login (200 { token, user })
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "testpass123"
}

###
@userId = {{login.response.body.user._id}}
@access_token = {{login.response.body.token}}

### Login con usuario del seed (Bill, ADMIN)
POST {{base}}/auth/login
Content-Type: application/json

{
    "email": "bill@initech.com",
    "password": "123456"
}

### Login fallido (401 INVALID_CREDENTIALS)
POST {{base}}/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "wrongpassword"
}

### Refresh (200)
POST {{base}}/auth/refresh

### Logout (204)
POST {{base}}/auth/logout

### Cambio de contraseña: solo el propio usuario (204).
### Cierra todas sus sesiones (revoca sus refresh tokens).
PUT {{base}}/users/{{userId}}/password
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "currentPassword": "testpass123",
    "newPassword": "newpass456"
}

### ============================================================
### USERS (todas requieren access token)
### ============================================================

### Sin token (401)
GET {{base}}/users

### Listar usuarios
GET {{base}}/users
Authorization: Bearer {{access_token}}

### Filtrar por rol (query param refina la colección)
GET {{base}}/users?role=ADMIN
Authorization: Bearer {{access_token}}

### Obtener un usuario
GET {{base}}/users/{{userId}}
Authorization: Bearer {{access_token}}

### PUT: reemplaza el recurso entero (name + email)
PUT {{base}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "name": "Test Updated",
    "email": "test@example.com"
}

### PATCH: modifica una parte
PATCH {{base}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "name": "Test Patched"
}

### PATCH con password -> 422 (la contraseña va por /users/:id/password)
PATCH {{base}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "password": "hacked123"
}

### Eliminar el propio usuario (204)
DELETE {{base}}/users/{{userId}}
Authorization: Bearer {{access_token}}
