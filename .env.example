NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/ea-exercise-jwt

# Secretos distintos para cada tipo de token (¡cámbialos!)
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh

# Duraciones en segundos: access 10 min, refresh 1 día
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=86400
